# Port untuk menjalankan AI Microservice secara lokal
PORT=5000

# API Key Google Gemini (https://aistudio.google.com/apikey)
# Jika dibiarkan kosong, service akan otomatis menggunakan fallback mock response yang realistis
GEMINI_API_KEY=

# Model Gemini yang digunakan untuk structured JSON output
GEMINI_MODEL=gemini-2.5-flash

# Daftar origin yang diizinkan oleh CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Opsional: Shared secret antara Backend dan AI service (biarkan kosong untuk dev lokal)
AI_SERVICE_SECRET=
