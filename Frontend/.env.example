# URL project Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (aman digunakan di client-side bersama RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL Backend REST API LingoLoop (lokal: http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL aplikasi Frontend (digunakan untuk redirect OAuth Google Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
