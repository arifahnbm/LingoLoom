# Port untuk menjalankan Backend API secara lokal
PORT=4000

# URL project Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (untuk verifikasi token autentikasi user)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (JANGAN pernah diekspos ke Frontend!)
# Digunakan untuk menulis vocab_cache dan operasi terverifikasi di Backend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# URL Frontend untuk konfigurasi CORS (bisa dipisah koma jika lebih dari satu)
FRONTEND_URL=http://localhost:3000

# URL AI Microservice (lokal: http://localhost:5000)
AI_SERVICE_URL=http://localhost:5000

# Opsional: harus sama dengan AI_SERVICE_SECRET di AI/.env jika diaktifkan
AI_SERVICE_SECRET=

# Batas kuota paket Free
FREE_DAILY_AUTOFILL_LIMIT=5
FREE_WEEKLY_STORY_LIMIT=1
