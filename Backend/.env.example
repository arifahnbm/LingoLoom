# Port untuk menjalankan Backend API secara lokal
PORT=4000

# URL project Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (untuk verifikasi token autentikasi user)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (JANGAN pernah diekspos ke Frontend!)
# Digunakan untuk operasi terverifikasi di Backend (vocab_cache, app_settings, admin)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret 32 karakter/hex untuk enkripsi AES-256-GCM custom Gemini API Key di app_settings
# Contoh buat cepat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=

# Secret header (x-internal-secret) untuk komunikasi aman antara Backend dan AI service
# Harus sama dengan INTERNAL_AI_SECRET di AI/.env
INTERNAL_AI_SECRET=

# URL Frontend untuk konfigurasi CORS (bisa dipisah koma jika lebih dari satu)
FRONTEND_URL=http://localhost:3000

# URL AI Microservice (lokal: http://localhost:5000)
AI_SERVICE_URL=http://localhost:5000

# Fallback batas kuota paket Free (jika tabel app_settings belum dimigrasi)
FREE_DAILY_AUTOFILL_LIMIT=5
FREE_WEEKLY_STORY_LIMIT=1
